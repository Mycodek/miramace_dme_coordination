# Copy to .env (make setup does this if .env is missing) and fill in keys.
# LLM_PROVIDER: gemini | openai | fake

LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
PCP_MAX_ATTEMPTS=3
SUPPLIER_MAX_ATTEMPTS=2
MAX_CONCURRENT_SUPPLIER_CONTACTS=3
